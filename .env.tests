# Environment variables loaded for all tests (via backend/conftest.py).
AUTH_GAME_TICKET_SECRET=test-secret
AUTH_COOKIE_SECURE=false
AUTH_PASSWORD_HASHER=simple
AUTH_DATABASE_PATH=/nonexistent/ronin-tests/storage.db
LOBBY_ALLOWED_HOSTS=testserver
LOBBY_WS_ALLOWED_ORIGIN=http://testserver
LOBBY_CONFIG_PATH=/nonexistent/ronin-tests/servers.yaml
LOBBY_REPLAY_DIR=/nonexistent/ronin-tests/replays
GAME_CORS_ORIGINS=http://testserver
GAME_REPLAY_DIR=/nonexistent/ronin-tests/replays
