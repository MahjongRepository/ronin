{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./src/*"]
        },
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "types": ["vite/client"],
        "lib": ["ES2023", "DOM", "DOM.Iterable"]
    },
    "include": ["src"]
}
