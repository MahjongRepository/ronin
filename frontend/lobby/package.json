{
    "name": "lobby",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "lint": "oxlint --deny-warnings . && stylelint 'src/**/*.scss' && node scripts/check-build.ts",
        "lint:fix": "oxlint --fix . && stylelint --fix 'src/**/*.scss'",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "dependencies": {
        "lit-html": "3.3.3"
    },
    "devDependencies": {
        "@types/node": "26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "happy-dom": "21.0.4",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "sass": "1.106.1",
        "stylelint": "17.16.0",
        "stylelint-config-standard-scss": "17.0.0",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "allowScripts": {
        "@parcel/watcher": false
    }
}
