{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn",
        "style": "warn"
    },
    "plugins": ["typescript", "unicorn", "oxc", "import"],
    "rules": {
        "import/no-relative-parent-imports": "error",
        "import/no-named-export": "off",
        "import/prefer-default-export": "off",
        "import/no-unassigned-import": "off",
        "import/max-dependencies": "off",
        "import/no-namespace": "off",
        "import/group-exports": "off",
        "import/exports-last": "off",
        "import/consistent-type-specifier-style": ["warn", "prefer-inline"],
        "func-style": ["error", "declaration"],
        "new-cap": [
            "warn",
            {
                "capIsNewExceptions": [
                    "Tile",
                    "TileBack",
                    "HandTileView",
                    "Meld",
                    "Hand",
                    "Discards",
                    "RoundEndDisplay",
                    "PlayerName",
                    "GameStartDisplay",
                    "GameEndDisplay",
                    "TablePanelDisplay",
                    "OverlayPanel",
                    "PanelActions",
                    "Melds",
                    "WinHand",
                    "IndicatorGroup",
                    "Indicators",
                    "PagerControls",
                    "YakuList",
                    "WinValue",
                    "ScoreGrid",
                    "WinPage",
                    "DrawPage",
                    "TenpaiHand",
                    "NagashiRivers",
                    "UncertainNote",
                    "GameBoard",
                    "HandArea",
                    "MeldsArea",
                    "River",
                    "Zones",
                    "CenterInfo",
                    "DiffLabels",
                    "EmptyCenterArea",
                    "Nameplate",
                    "NameplateMarks",
                    "Nameplates",
                    "Strip",
                    "CenterSeat",
                    "LeaveIcon",
                    "GameMenu",
                    "DebugLabel",
                    "DoraDisplay",
                    "HonbaStickIcon",
                    "RiichiStickIcon",
                    "ScoreFigures",
                    "RotatePanel",
                    "HandSlot",
                    "TileFaceView",
                    "MeldTileView",
                    "PlayBoard",
                    "DecisionControls",
                    "TimerDigits",
                    "DecisionTimer",
                    "ActionTiles",
                    "Lamp",
                    "FuritenMark",
                    "OwnHead",
                    "Callouts",
                    "Callout",
                    "SeatRow",
                    "ActionButton",
                    "ResultTime",
                    "ResultControlsView",
                    "ScoreFoot",
                    "BoardNotices",
                    "LeaveConfirm",
                    "FailurePanel",
                    "NoticeSheet",
                    "SheetNotice",
                    "SheetNote",
                    "ShowAll",
                    "NoticeAnnouncements",
                    "CalloutAnnouncements",
                    "PlayOverlay",
                    "ReplayControls",
                    "RoundList",
                    "ReplayStatus",
                    "Icon",
                    "JumpButton",
                    "PlayButton",
                    "RoundsButton",
                    "EndRow",
                    "IncompleteNote",
                    "OptionButton",
                    "StepButton",
                    "SwitchButton",
                    "PlaySwitches",
                    "SwitchNames"
                ]
            }
        ],
        "capitalized-comments": "off",
        "no-magic-numbers": "off",
        "no-ternary": "off",
        "one-var": "off",
        "unicorn/no-null": "off",
        "unicorn/prefer-global-this": "off",
        "unicorn/prefer-add-event-listener": "warn",
        "sort-imports": [
            "warn",
            {
                "ignoreDeclarationSort": true
            }
        ],
        "id-length": [
            "warn",
            {
                "exceptions": ["t", "a", "s", "d", "m", "p", "f", "w", "n", "h", "r", "z", "i"]
            }
        ]
    },
    "overrides": [
        {
            "files": ["src/**"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "zod",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            },
                            {
                                "name": "zod/v4",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            },
                            {
                                "name": "zod/v4/classic",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            },
                            {
                                "name": "zod/v3",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            }
                        ],
                        "patterns": [
                            {
                                "regex": "^#tests(/|$)|(^|/)tests(/|$)|^@/(.*/)?\\.\\.(/|$)",
                                "message": "Application code never imports the tests or reaches outside src through the alias."
                            },
                            {
                                "group": ["@/fixtures/**"],
                                "message": "Generated fixtures ship only in the storybook's chunk: import them from a storybook view."
                            },
                            {
                                "group": ["@/entities/*/**"],
                                "message": "Import another slice through its public entry, @/entities/<slice>, never its internals."
                            },
                            {
                                "group": ["@/shared/*/**"],
                                "message": "Import a shared module through its public entry, @/shared/<module>, never its internals."
                            }
                        ]
                    }
                ]
            }
        },
