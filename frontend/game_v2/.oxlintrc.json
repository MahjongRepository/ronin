{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn",
        "style": "warn"
    },
    "plugins": ["typescript", "unicorn", "oxc", "import"],
    "rules": {
        "import/no-relative-parent-imports": "error",
        "import/no-named-export": "off",
        "import/prefer-default-export": "off",
        "import/no-unassigned-import": "off",
        "import/max-dependencies": "off",
        "import/no-namespace": "off",
        "import/group-exports": "off",
        "import/exports-last": "off",
        "import/consistent-type-specifier-style": ["warn", "prefer-inline"],
        "func-style": ["error", "declaration"],
        "new-cap": [
            "warn",
            {
                "capIsNewExceptions": [
                    "Tile",
                    "TileBack",
                    "HandTileView",
                    "Meld",
                    "Hand",
                    "Discards",
                    "RoundEndDisplay",
                    "StandingsPanel",
                    "StandingsCell",
                    "StandingsRoundLabel",
                    "StandingsRoundRow",
                    "StandingsFootRow",
                    "StandingsFoot",
                    "StandingsActionView",
                    "StandingsLegend",
                    "RoundHint",
                    "PlayerName",
                    "Mark",
                    "RiichiMark",
                    "GameStartDisplay",
                    "Melds",
                    "WinHand",
                    "IndicatorGroup",
                    "PagerControls",
                    "YakuList",
                    "WinValue",
                    "ScoreGrid",
                    "WinPage",
                    "DrawPage",
                    "TenpaiHand",
                    "GameBoard",
                    "HandArea",
                    "MeldsArea",
                    "River",
                    "Zones",
                    "CenterInfo",
                    "DiffLabels",
                    "EmptyCenterArea",
                    "Nameplate",
                    "Nameplates",
                    "Strip",
                    "CenterSeat",
                    "LeaveIcon",
                    "GameMenu",
                    "DebugLabel",
                    "DoraDisplay",
                    "HonbaStickIcon",
                    "RiichiStickIcon",
                    "RotatePanel",
                    "HandSlot",
                    "TileFaceView",
                    "MeldTileView",
                    "PlayBoard",
                    "DecisionControls",
                    "CountdownView",
                    "TurnCountdownView",
                    "Callouts",
                    "Callout",
                    "SeatRow",
                    "ActionButton",
                    "ResultTime",
                    "ResultControlsView",
                    "ScoreFoot",
                    "BoardNotices",
                    "LeaveConfirm",
                    "FailurePanel",
                    "PlayOverlay",
                    "ReplayControls",
                    "RoundList",
                    "MoveIcon",
                    "MoveButton",
                    "IncompleteNote",
                    "OptionButton",
                    "PlaybackOptions",
                    "StepButton"
                ]
            }
        ],
        "capitalized-comments": "off",
        "no-magic-numbers": "off",
        "no-ternary": "off",
        "one-var": "off",
        "unicorn/no-null": "off",
        "unicorn/prefer-global-this": "off",
        "unicorn/prefer-add-event-listener": "warn",
        "sort-imports": [
            "warn",
            {
                "ignoreDeclarationSort": true
            }
        ],
        "id-length": [
            "warn",
            {
                "exceptions": ["t", "a", "s", "d", "m", "p", "f", "w", "n", "h", "r", "z", "i"]
            }
        ]
    },
    "overrides": [
        {
            "files": ["src/**"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "zod",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            },
                            {
                                "name": "zod/v4",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            },
                            {
                                "name": "zod/v4/classic",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            },
                            {
                                "name": "zod/v3",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            }
                        ],
                        "patterns": [
                            {
                                "group": ["@/fixtures/*"],
                                "message": "Generated fixtures ship only in the storybook's chunk: import them from a storybook view."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["src/views/storybook-*.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "zod",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            },
                            {
                                "name": "zod/v4",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            },
                            {
                                "name": "zod/v4/classic",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            },
                            {
                                "name": "zod/v3",
                                "message": "Import zod/mini: classic Zod does not tree-shake and would ship whole in the entry."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["vite.config.ts", "vitest.config.ts"],
            "rules": {
                "import/no-nodejs-modules": "off"
            }
        },
        {
            "files": ["scripts/**"],
            "rules": {
                "import/no-nodejs-modules": "off",
                "import/no-relative-parent-imports": "off",
                "no-console": "off",
                "max-statements": "off",
                "no-await-in-loop": "off"
            }
        },
        {
            "files": ["src/shared/websocket/websocket.ts"],
            "rules": {
                "unicorn/prefer-add-event-listener": "off"
            }
        },
        {
            "files": ["src/shared/protocol/schemas/**"],
            "rules": {
                "unicorn/max-nested-calls": "off",
                "max-statements": "off"
            }
        },
        {
            "files": ["src/entities/table/model/apply-event.ts"],
            "rules": {
                "max-statements": "off"
            }
        },
        {
            "files": ["tests/**"],
            "rules": {
                "unicorn/consistent-function-scoping": "off",
                "unicorn/no-unreadable-array-destructuring": "off",
                "typescript/parameter-properties": "off",
                "oxc/no-map-spread": "off"
            }
        }
    ],
    "ignorePatterns": ["coverage/**", "src/assets/**"]
}
