{
    "name": "game-v2",
    "private": true,
    "type": "module",
    "sideEffects": [
        "*.scss",
        "./src/zod-setup.ts"
    ],
    "imports": {
        "#tests/*": "./tests/*.ts"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.scripts.json",
        "lint": "oxlint --deny-warnings . && stylelint 'src/**/*.scss' && sass --fatal-deprecation=\"$(sass --version | cut -d ' ' -f 1)\" --quiet-deps --no-source-map --style=compressed --load-path=node_modules src/styles/game-app.scss:/dev/null src/styles/replay-page.scss:/dev/null src/styles/storybook-page.scss:/dev/null",
        "lint:fix": "oxlint --fix . && stylelint --fix 'src/**/*.scss'",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "sprite": "node scripts/build-tile-sprite.ts",
        "visual-check": "vite build && node scripts/visual-check/run.ts",
        "test": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@msgpack/msgpack": "3.1.3",
        "@picocss/pico": "2.1.1",
        "lit-html": "3.3.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "happy-dom": "21.0.4",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "playwright": "1.63.0",
        "sass": "1.106.1",
        "stylelint": "17.16.0",
        "stylelint-config-standard-scss": "17.0.0",
        "svgo": "4.1.0",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "allowScripts": {
        "@parcel/watcher": false
    }
}
