@import "font"
@import "pai"
@import "shoupai"
@import "he"

page-background = #154
page-text = white
page-accent = #fc6

body.page
body.storybook
    margin: 0
    padding: 16px
    background: page-background
    color: page-text
    font-family: menu-font
    a
        color: page-accent

.missing-session
    font-size: 24px
    padding: 40px
    text-align: center

.replay
    h1
        font-size: 20px
    .replay-content
        font-family: fixed-font
        font-size: 12px
        white-space: pre-wrap
        word-break: break-all

.storybook-header
    h1
        font-size: 24px
        margin: 8px 0
    .storybook-nav
        display: flex
        flex-wrap: wrap
        gap: 6px
        margin-bottom: 16px
        font-size: 15px
        a
            padding: 2px 10px
            white-space: nowrap
            border: solid 1px page-accent
            border-radius: 12px
            font-family: menu-font
            text-decoration: none
            &.active
                background: page-accent
                color: page-background

body.board:has(> .storybook-header)
    display: flow-root

body.board > .storybook-header
    display: flow-root
    color: page-text
    a
        color: page-accent

.storybook-samples
    max-width: 800px
    .storybook-sample
        margin-bottom: 24px
        h2
            font-size: 16px
            font-weight: normal
        .shoupai
            shoupai-size: 680px 60px 56px 42px
        .he
            he-size: 300px 42px
    .storybook-tile-row
        display: flex
        flex-wrap: wrap
        gap: 4px
        margin-bottom: 8px
    .storybook-tile
        margin: 0
        text-align: center
        pai-size: 56px
        figcaption
            font-family: fixed-font
            font-size: 12px

.storybook-header .storybook-variants
    font-size: 14px

@media screen and (max-height: 450px)
    body.storybook
        padding: 8px 16px

    body.board > .storybook-header
    body.storybook > .storybook-header
        display: flex
        align-items: center
        gap: 8px
        padding: 4px 0
        overflow-x: auto
        scrollbar-width: none
        scroll-padding-inline: 8px
        h1
            flex: none
            margin: 0
            font-size: 14px
        .storybook-nav
            flex: none
            flex-wrap: nowrap
            gap: 4px
            margin: 0
            font-size: 13px
            a
                padding: 1px 8px
        .storybook-variants
            padding-left: 8px
            border-left: solid 1px page-accent

    body.board > .storybook-header
        box-sizing: border-box
        padding-inline: 8px
