#board > .board
    height: 450px
    .score
        width:  280px
        height: 100px
        transform: translate(260px, 165px)
        font-size: 14px
        .juchang
            height: 48px
            padding: 4px
            .jushu
                float: left
                font-size: 30px
            .jicun
                float: left
                padding: 2px 0 0 10px
                font-size: 14px
        .shan
            padding: 4px
            pai-size: 28px
        .defen
            div
                width: 90px
                height: 20px
                font-size: 16px
                &.main
                    transform: translate(95px, 15px)
                &.xiajia
                    transform: translate(185px, 0px)
                &.duimian
                    transform: translate(95px, -15px)
                &.shangjia
                    transform: translate(5px, 0px)
    .timer
        transform: translate(98px, 357px)
    .player-button
        transform: translate(98px, 348px)
        min-width: 184px + 4 * 82px
        .button
            width: 5em
            height: 24px
            padding: 8px 0
            margin-left: 2px
            font-size: 16px
    .select-mianzi
        z-index: 1
        transform: translate(98px, 346px)
        min-width: 572px
        max-width: 572px
        .mianzi
            padding: 4px
            margin-left: 4px
            mianzi-size: 35px
        .back
            flex-shrink: 1
            min-width: 50px
            width: 5em
            height: 24px
            padding: 8px 0
            margin-left: 2px
            font-size: 16px
    .player-button::before
    .select-mianzi::before
        width: 184px
    > .player
        font-size: 15px
        width: 150px
        height: 40px
        border-radius: 4px
        padding: 3px 6px 3px 4px
        .feng
            width: 30px
            height: 30px
            font-size: 20px
        .info
            font-size: 12px
        &.main
            transform: translate(132px, 344px)
        &.xiajia
            transform: translate(519px, 295px)
        &.duimian
            transform: translate(480px, 50px)
        &.shangjia
            transform: translate(145px, 92px)
    .he
        he-size: 250px 35px
        &.main
            transform: translate(325px, 265px)
        &.xiajia
            transform: translate(540px, 290px) rotate(270deg)
        &.duimian
            transform: translate(475px, 165px) rotate(180deg)
        &.shangjia
            transform: translate(260px, 140px) rotate(90deg)
    // The bottom and top hands sit 4px in from the table edge, and the side
    // melds end 8px short of it, so no tile runs into the board's border.
    .shoupai
        &.main
            shoupai-size: 604px 60px 56px 42px
            transform: translate(98px, 386px)
            z-index: 1
        &.xiajia
            shoupai-size: 442px 87px 35px 34px
            transform: translate(672px, 450px) rotate(270deg)
            .bingpai
                margin-left: 72px
        &.duimian
            shoupai-size: 490px 50px 35px 35px
            transform: translate(645px, 54px) rotate(180deg)
        &.shangjia
            shoupai-size: 442px 87px 35px 34px
            transform: translate(128px, 0px) rotate(90deg)
            .bingpai
                margin-left: 20px
    .say
        z-index: 1
        width:  200px
        height: 100px
        font-size: 64px
        &.main
            transform: translate(300px, 295px)
        &.xiajia
            transform: translate(540px, 165px)
        &.duimian
            transform: translate(300px, 35px)
        &.shangjia
            transform: translate(60px, 165px)
    .hule-dialog
        width: 800px
        height: 450px
        > div
            width: 800px
            padding: 6px 0px
            > div
                min-width: 520px
                padding: 8px 16px
                > .title
                    font-size: 20px
                    margin-bottom: 4px
                .hule
                    .shan
                        pai-size: 24px
                        &.baopai
                            margin-left: 20px
                        &.fubaopai
                            margin-right: 20px
                    .shoupai
                        shoupai-size: auto 50px 35px 35px
                    .hupai
                        margin: 4px auto
                        min-width: 260px
                        font-size: 17px
                    .jicun
                        font-size: 13px
                .pingju
                    margin: 12px 0
                    .name
                        font-size: 36px
                    .players
                        margin-top: 4px
                        font-size: 16px
                .fenpei
                    margin-top: 6px
                    font-size: 15px
                    td
                        padding: 1px 8px
                .next
                    margin-top: 6px
                    padding: 4px 16px
                    font-size: 15px
    > .summary
        width: 800px
        height: 450px
        > div
            width: 800px
            min-height: 0
            padding: 2px 0px
            > div
                width: 680px
                padding: 4px 0px
                table
                    width: 640px
                    font-size: 16px
                    line-height: 1.15
                    .r_player
                        .player
                            width: 114px
                    .r_rank
                        .title
                            font-size: 24px
                        .rank
                            font-size: 14px
                    .r_point
                        .point
                            font-size: 20px
                .footer
                    width: 640px
                    margin-top: 6px
                    font-size: 13px
                    .exit
                        padding: 3px 14px
                        font-size: 15px
    .kaiju
        width: 800px
        height: 450px
        > div
            margin-top: 60px
    .suspend
        z-index: 1
        width: 800px
        height: 450px

#board
    .controller
        top: 4px
        right: 4px
    .download
        transform: translate(10px, 5px)

body.analyzer
    #board
        > .analyzer
            display: none
            z-index: 1
            transform: translate(10px, 10px)
            width: 740px
            height: 360px
            background: rgba(0,0,0,0.4)
            &.active
                display: block
            .selected
                background: rgba(192,192,192,0.6)
            img
                opacity: 0.8
