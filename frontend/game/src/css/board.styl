body.board
    color: white
    background: black
    margin: 0
    > *
        width: 800px
        margin: 0 auto
    #board
        display: block
#space
    display: none

#board
    display: none
#board > .board
    position: absolute
    width: 800px
    overflow: hidden
    user-select: none
    touch-action: manipulation
    margin: 0 auto
    background: #154
    > *
        position: absolute
        transform-origin: 0% 0%
    .score
        border-radius: 4px
        background: #111
        font-family: defen-font
        .juchang
            float: left
            .jushu
                font-family: title-font
                font-size: 32px
                line-height: 1.2
            .jicun
                line-height: 1.25
                white-space: nowrap
                > span
                    display: block
        .shan
            float: right
            text-align: right
        .defen
            clear: both
            div
                position: absolute
                &.lunban
                    color: #0ff
                &.main
                    text-align: center
                &.xiajia
                    text-align: right
                &.duimian
                    text-align: center
                &.shangjia
                    text-align: left
    .timer
        color: white
        font-size: 16px
        font-family: defen-font
        text-align: right
        text-shadow: 2px 2px 4px black
    .player-button
        z-index: 1
        text-align: right
        white-space: nowrap
        display: flex
        justify-content: end
        .button
            cursor: pointer
            display: inline-block
            text-align: center
            font-family: menu-font
            color: white
            background: black;
            border-radius: 4px;
            &.rong
            &.zimo
                background: #b71c1c
                font-weight: bold
            &:focus
                outline: none
                box-shadow: inset 0 0 0 2px #fc6
    .select-mianzi
        z-index: 1
        line-height: 1
        text-align: right
        white-space: nowrap
        .mianzi
        .back
            background: black
            border-radius: 4px
            cursor: pointer
            &:focus
                outline: none
                box-shadow: inset 0 0 0 2px #fc6
        .back
            position: absolute
            left: 100%
            bottom: 0
            font-family: menu-font
            color: white
            text-align: center
    > .player
        box-sizing: border-box
        display: grid
        grid-template-columns: auto minmax(0, 1fr)
        align-items: center
        column-gap: 0.4em
        background: rgba(0, 0, 0, 0.55)
        border: solid 1px rgba(255, 255, 255, 0.15)
        color: #eee
        font-family: text-font
        white-space: nowrap
        overflow: hidden
        .feng
            grid-row: 1 / 3
            display: flex
            align-items: center
            justify-content: center
            border-radius: 4px
            background: rgba(255, 255, 255, 0.15)
            font-family: title-font
            line-height: 1
        .name
            overflow: hidden
            text-overflow: ellipsis
            line-height: 1.15
        .info
            display: flex
            align-items: center
            gap: 0.4em
            line-height: 1.2
        .defen
            font-family: defen-font
            color: #ccc
        .badge
            padding: 0 0.3em
            border-radius: 3px
            font-family: menu-font
            line-height: 1.35
            &.dealer
                background: #fc6
                color: black
            &.offline
                background: #b71c1c
                color: white
        &.disconnect
            .name
            .defen
                color: #999
        &.lunban
            border-color: #0ff
            background: rgba(0, 48, 48, 0.8)
            .feng
                background: #0ff
                color: black
    .say
        font-family: text-font
        color: white
        text-shadow: 3px  3px 6px #333,
                    -3px  3px 6px #333,
                    -3px -3px 6px #333,
                     3px -3px 6px #333
        transition: opacity 0.4s ease-out
        &.main
            text-align: center
        &.xiajia
            text-align: left
        &.duimian
            text-align: center
        &.shangjia
            text-align: right
    .hule-dialog
        z-index: 3
        display: flex
        overflow: auto
        align-items: center
        background: rgba(0, 0, 0, 0.5)
        transition: opacity 0.2s ease-in
        &:focus
            outline: none
        > div
            margin: auto 0
            > div
                box-sizing: border-box
                background: rgb(3,17,14)
                border: solid 1px #375
                border-radius: 6px
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6)
                margin: auto
                > .title
                    font-family: text-font
                    text-align: center
                    line-height: 1.2
                .hule
                    .shan
                        font-family: title-font
                        img
                            vertical-align: bottom
                        &.baopai
                            float: left
                        &.fubaopai
                            float: right
                    .shoupai
                        clear: both
                        margin: 0 auto
                    .hupai
                        font-family: title-font
                        line-height: 1
                        .fanshu
                            text-align: right
                        .defen
                            text-align: right
                    .jicun
                        text-align: center
                        font-family: defen-font
                        > span + span
                            margin-left: 1.5em
                .pingju
                    text-align: center
                    .name
                        font-family: title-font
                        line-height: 1.2
                    .players
                        font-family: text-font
                        &:empty
                            display: none
                .fenpei
                    margin: 0 auto
                    border-collapse: collapse
                    font-family: defen-font
                    td
                        padding: 2px 8px
                        white-space: nowrap
                    tr.main
                        background: rgba(255, 255, 255, 0.1)
                        font-weight: bold
                    .feng
                        color: #fc6
                    .player
                        font-family: text-font
                        max-width: 9em
                        overflow: hidden
                        text-overflow: ellipsis
                    .tenpai
                        font-family: text-font
                        color: #fc6
                        &.noten
                            color: #999
                    .defen
                    .diff
                        text-align: right
                    .diff
                        min-width: 4.5em
                    .plus
                        color: #0ff
                    .minus
                        color: #f66
                .next
                    display: block
                    margin: 0 0 0 auto
                    border: solid 1px #fc6
                    border-radius: 4px
                    background: transparent
                    color: #fc6
                    font-family: menu-font
                    cursor: pointer
                    &:hover
                    &:focus-visible
                        background: #fc6
                        color: black
                        outline: none
    > .summary
        z-index: 3
        display: flex
        overflow: auto
        align-items: center
        background: rgba(0, 0, 0, 0.5)
        transition: opacity 0.2s ease-out
        &:focus
            outline: none
        > div
            margin: auto 0
            > div
                box-sizing: border-box
                background: rgb(3,17,14)
                border: solid 1px #375
                border-radius: 6px
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6)
                margin: auto
                .lizhi
                    font-family: menu-font
                    display: inline-block
                    width: 1.2em
                    margin-left: 0.2em
                    font-size: 0.7em
                    line-height: 1.4
                    vertical-align: middle
                    text-align: center
                    color: #fc6
                    &:not(:empty)
                        border: solid 1px #fc6
                        border-radius: 3px
                table
                    margin: auto
                    font-family: text-font
                    border-collapse: collapse
                    line-height: 1.5
                    .r_rank
                        .title
                            font-family: title-font
                            text-align: left
                            vertical-align: middle
                        .rank
                            font-family: menu-font
                            text-align: center
                            color: #999
                            &.top
                                color: #fc6
                                font-weight: bold
                    .r_player
                        border-bottom: solid 2px
                    .r_diff
                        .back
                            text-align: right
                        .zhuangjia
                            background: rgba(128,128,128,0.4)
                        .diff
                            font-family: defen-font
                            &.even
                                font-family: text-font
                                font-size: 0.8em
                                color: #999
                    .r_gongtuo
                        border-top: solid 1px #555
                        th
                            text-align: left
                        td
                            text-align: right
                            padding-right: 1.6em
                        .diff
                            font-family: defen-font
                    .label
                        font-family: text-font
                        text-align: left
                        white-space: nowrap
                        small
                            margin-left: 0.4em
                            font-size: 0.65em
                            font-weight: normal
                            color: #999
                    .r_defen
                        border-top: solid 2px
                        .defen
                            font-family: defen-font
                            text-align: right
                            padding-right: 1.6em
                    .r_point
                        border-top: solid 1px
                        .point
                            font-family: defen-font
                            text-align: center
                    .baojia
                    .minus
                        color: red
                    .hule
                    .plus
                        color: #0ff
                    a.download
                        opacity: 0.6
                        font-family: menu-font
                        font-size: 18px
                        text-decoration: none
                        color: white
                        &::link
                            color: white
                        img
                            height: 1em
                            vertical-align: text-bottom
                .footer
                    display: flex
                    align-items: center
                    justify-content: space-between
                    margin: auto
                    font-family: text-font
                    .legend
                        color: #999
                        .zhuangjia
                            display: inline-block
                            width: 1em
                            height: 1em
                            margin-right: 0.3em
                            vertical-align: -0.15em
                            background: rgba(128,128,128,0.4)
                        .lizhi
                            margin: 0 0.3em 0 1.2em
                    .exit
                        border: solid 1px #fc6
                        border-radius: 4px
                        background: transparent
                        color: #fc6
                        font-family: menu-font
                        cursor: pointer
                        &:hover
                        &:focus-visible
                            background: #fc6
                            color: black
                            outline: none
    > .summary.paipu tbody tr:hover
        background: rgba(256,256,256,0.4)
        cursor: pointer
    .kaiju
        &:focus
            outline: none
    .kaiju > div
        z-index: 1
        margin-top: 120px
        position: relative
        width: 580px
        margin: auto
        background: #111
        border: solid 1px #111
        border-radius: 6px
        .title
            margin: 40px 20px
            text-align: center
            font-family: title-font
            font-size: 32px
            line-height: 1
            .sub
                margin-top: 12px
                font-family: text-font
                font-size: 18px
                color: #999
        .player
            margin: 40px 20px
            height: 132px
            text-align: center
            font-family: text-font
            font-size: 24px
            > div
                position: absolute
                width: 240px
                height: 38px
                padding: 0px 10px
                border-radius: 4px
                background: #333
                white-space: nowrap
                overflow: hidden
                text-overflow: ellipsis
                &.selectable
                    cursor: pointer
                    &:hover
                        background: #999
                &.main
                    transform: translate(140px, 96px)
                &.xiajia
                    transform: translate(280px, 48px)
                &.duimian
                    transform: translate(140px, 0px)
                &.shangjia
                    transform: translate(0px, 48px)
    .suspend
        background: rgba(0, 0, 0, 0.5);

#board
    .controller
        position: absolute
        z-index: 2
        button
            display: block
            margin: 0
            border: none
            background: transparent
            color: white
            cursor: pointer
            &:focus-visible
                outline: solid 2px #fc6
                outline-offset: 2px
        .settings-toggle
            width: 40px
            height: 40px
            padding: 8px
            border-radius: 6px
            opacity: 0.6
            &:hover
            &:focus-visible
            &[aria-expanded="true"]
                opacity: 1
                background: rgba(255, 255, 255, 0.15)
            svg
                display: block
                pointer-events: none
                width: 100%
                height: 100%
        .settings-menu
            position: absolute
            top: 44px
            right: 0
            padding: 6px
            background: black
            border: solid 1px #666
            border-radius: 6px
            font-family: menu-font
            font-size: 16px
        .sound
            display: flex
            align-items: center
            gap: 8px
            min-width: 140px
            padding: 6px 8px
            border-radius: 4px
            font: inherit
            white-space: nowrap
            &:hover
                background: rgba(255, 255, 255, 0.15)
            img
                width: 20px
                height: 20px
            &[aria-checked="true"] img.off
            &[aria-checked="false"] img.on
                display: none
            .state
                margin-left: auto
                font-weight: bold
    .download
        position: absolute
        z-index: 1
        a
            opacity: 0.7
            display: inline-block
            color: white
            background: black
            text-decoration: none
            font-size: 18px
            font-family: menu-font
            padding: 6px 10px
            border-radius: 6px
            cursor: pointer
            img
                height: 1.2em
                margin-right: 0.5em
                vertical-align: middle
            &:hover
                opacity: 1
    .tenhou-dialog
        position: absolute
        z-index: 1
        background: rgba(0, 0, 0, 0.5);
        form
            padding: 15px
            background: white
            border-radius: 4px
            font-family: menu-font
            font-size: 14px
            color: black
            li
                display: inline-block
                margin-right: 0.5em
            textarea
                box-sizing: border-box
                width: 100%
                resize: none
                &.URL
                    white-space: pre
                &.JSON
                    word-break: break-all
            .button
                text-align: right

@media screen and (max-height: 680px)
    body.board
        height: 100dvh
        #space
            display: block
            background: #666
            height: 100px
        #navi
            display: none
