#board > .board
    height: 680px
    .score
        width:  280px
        height: 160px
        transform: translate(260px, 260px)
        font-size: 14px
        .juchang
            height: 72px
            padding: 6px
            .jushu
                font-size: 32px
            .jicun
                padding: 2px 4px 0
                font-size: 15px
        .shan
            padding: 6px
            pai-size: 42px
        .defen
            div
                width: 120px
                height: 24px
                font-size: 16px
                &.main
                    transform: translate(80px, 48px)
                &.xiajia
                    transform: translate(150px, 24px)
                &.duimian
                    transform: translate(80px, 0px)
                &.shangjia
                    transform: translate(10px, 24px)
    .timer
        transform: translate(120px, 600px)
    .player-button
        transform: translate(120px, 580px)
        min-width: 180px + 4 * 66px
        .button
            width: 4em
            height: 24px
            margin-left: 2px
            font-size: 16px
    .select-mianzi
        transform: translate(120px, 560px)
        .mianzi
            padding: 4px
            margin-left: 4px
            mianzi-size: 42px
        .back
            width: 4em
            height: 24px
            margin-left: 4px
            font-size: 16px
    .player-button::before
    .select-mianzi::before
        width: 180px
    > .player
        font-size: 18px
        width: 180px
        height: 46px
        border-radius: 6px
        padding: 4px 8px 4px 5px
        .feng
            width: 34px
            height: 34px
            font-size: 24px
        .info
            font-size: 14px
        &.main
            transform: translate(120px, 566px)
        &.xiajia
            transform: translate(540px, 440px)
        &.duimian
            transform: translate(500px, 60px)
        &.shangjia
            transform: translate(80px, 198px)
    .he
        he-size: 300px 42px
        &.main
            transform: translate(310px, 420px)
        &.xiajia
            transform: translate(540px, 430px) rotate(270deg)
        &.duimian
            transform: translate(490px, 260px) rotate(180deg)
        &.shangjia
            transform: translate(260px, 250px) rotate(90deg)
    // Each hand sits 4px in from its own edge of the table and its melds end
    // 6px short of the next edge, so no tile runs into the board's border.
    .shoupai
        &.main
            shoupai-size: 674px 60px 56px 42px
            transform: translate(120px, 616px)
        &.xiajia
            shoupai-size: 554px 60px 42px 42px
            transform: translate(736px, 560px) rotate(270deg)
        &.duimian
            shoupai-size: 674px 60px 42px 42px
            transform: translate(680px, 64px) rotate(180deg)
        &.shangjia
            shoupai-size: 554px 60px 42px 42px
            transform: translate(64px, 120px) rotate(90deg)
    .say
        width:  200px
        height: 100px
        font-size: 64px
        &.main
            transform: translate(300px, 520px)
        &.xiajia
            transform: translate(600px, 290px)
        &.duimian
            transform: translate(300px, 50px)
        &.shangjia
            transform: translate(0px, 290px)
    .hule-dialog
        width: 800px
        height: 680px
        > div
            width: 800px
            padding: 10px 0px
            > div
                min-width: 600px
                padding: 16px 20px
                > .title
                    font-size: 26px
                    margin-bottom: 12px
                .hule
                    .shan
                        pai-size: 35px
                        &.baopai
                            margin-left: 20px
                        &.fubaopai
                            margin-right: 20px
                    .shoupai
                        shoupai-size: auto 70px 49px 49px
                    .hupai
                        margin: 10px auto
                        min-width: 300px
                        font-size: 24px
                    .jicun
                        font-size: 16px
                .pingju
                    margin: 24px 0
                    .name
                        font-size: 48px
                    .players
                        margin-top: 8px
                        font-size: 20px
                .fenpei
                    margin-top: 14px
                    font-size: 18px
                    td
                        padding: 3px 10px
                .next
                    margin-top: 14px
                    padding: 6px 20px
                    font-size: 18px
    > .summary
        width: 800px
        height: 680px
        > div
            width: 800px
            min-height: 560px
            padding: 10px 0px
            > div
                width: 680px
                padding: 18px 0px
                table
                    width: 640px
                    font-size: 18px
                    .r_player
                        .player
                            width: 114px
                    .r_rank
                        .title
                            font-size: 28px
                        .rank
                            font-size: 16px
                    .r_point
                        .point
                            font-size: 24px
                .footer
                    width: 640px
                    margin-top: 12px
                    font-size: 15px
                    .exit
                        padding: 6px 20px
                        font-size: 18px
    .kaiju
        width: 800px
        height: 680px
        > div
            margin-top: 120px
    .suspend
    .tenhou-dialog
        width: 800px
        height: 680px
    .tenhou-dialog
        form
            width: 480px
            margin: 100px auto

#board
    .controller
        top: 8px
        right: 8px
    .download
        transform: translate(10px, 10px)

body.analyzer
    #board
        > .analyzer
            display: none
            position: absolute
            transform: translate(50px, 160px)
            width: 700px
            height: 400px
            background: rgba(0,0,0,0.4)
            text-shadow: 2px 2px 4px black
            &.active
                display: block
            .selected
                background: rgba(144,144,144,0.6)
            img
                opacity: 0.8

@media screen and (max-width: 800px) and (min-height: 451px) and (pointer: coarse)
    #board
        .controller
            .settings-toggle
                width: 80px
                height: 80px
                padding: 16px
            .settings-menu
                top: 88px
                padding: 12px
                font-size: 32px
            .sound
                gap: 16px
                min-width: 280px
                padding: 12px 16px
                img
                    width: 40px
                    height: 40px
