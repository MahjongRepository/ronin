{
    "name": "game",
    "version": "2.5.4",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "echo 'plain JavaScript app: nothing to typecheck'",
        "lint": "oxlint --deny-warnings . && stylelint 'src/**/*.scss' && sass --fatal-deprecation=\"$(sass --version | cut -d ' ' -f 1)\" --no-source-map --style=compressed src/styles/game-app.scss:/dev/null",
        "lint:fix": "oxlint --fix . && stylelint --fix 'src/**/*.scss'",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@msgpack/msgpack": "3.1.3",
        "jquery": "4.0.0"
    },
    "devDependencies": {
        "happy-dom": "21.0.4",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "sass": "1.106.1",
        "stylelint": "17.16.0",
        "stylelint-config-standard-scss": "17.0.0",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "allowScripts": {
        "@parcel/watcher": false
    }
}
