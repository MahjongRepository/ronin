{
    "name": "game",
    "version": "2.5.4",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "echo 'plain JavaScript app: nothing to typecheck'",
        "lint": "eslint --max-warnings 0 . && stylelint 'src/**/*.scss' && sass --fatal-deprecation slash-div --no-source-map --style=compressed src/styles/game-app.scss:/dev/null",
        "lint:fix": "eslint --fix . && stylelint --fix 'src/**/*.scss'",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@msgpack/msgpack": "^3.1.0",
        "jquery": "^3.7.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "eslint": "^9.39.0",
        "globals": "^16.5.0",
        "happy-dom": "^20.7.0",
        "oxfmt": "^0.35.0",
        "sass": "^1.97.3",
        "stylelint": "^17.1.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "vite": "^7",
        "vitest": "^4.0.18"
    }
}
